@model RealEstateMarketplace.Models.User

@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5">

                    <!-- Header -->
                    <div class="text-center mb-4">

                        <div class="mb-3">
                            <span class="display-5">🏠</span>
                        </div>

                        <h2 class="fw-bold mb-2">
                            Create Your Account
                        </h2>

                        <p class="text-muted">
                            Join our marketplace and discover your next property.
                        </p>

                    </div>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email -->
                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg rounded-3"
                                   type="email"
                                   placeholder="example@email.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Password -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Password
                            </label>

                            <input name="password"
                                   class="form-control form-control-lg rounded-3"
                                   type="password"
                                   placeholder="Create a password"
                                   required />

                            <span class="text-danger">
                                @Html.ValidationMessage("password")
                            </span>

                        </div>

                        <!-- Register Button -->
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold">
                            Create Account
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Already have an account?
                        </span>

                        <a asp-action="Login"
                           class="text-decoration-none fw-semibold">
                            Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

