@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->

<section class="py-5 mb-5"
         style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);
                border-radius: 0 0 45px 45px;">

    <div class="container py-5">

        <div class="row align-items-center g-5">

            <!-- Hero Content -->
            <div class="col-lg-7 text-white">

                <span class="badge rounded-pill bg-white text-primary px-3 py-2 mb-4">
                    🏠 Smart Real Estate Marketplace
                </span>

                <h1 class="display-3 fw-bold lh-1 mb-4">
                    Find a Place
                    <br />
                    <span style="color: #93c5fd;">
                        You'll Love.
                    </span>
                </h1>

                <p class="lead text-white-50 mb-4"
                   style="max-width: 650px;">

                    Discover apartments, houses, villas, land and
                    commercial properties — all in one smart marketplace.

                </p>

                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="btn btn-light btn-lg px-4 py-3 rounded-3 fw-semibold shadow">

                        Explore Properties
                        <span class="ms-2">→</span>

                    </a>

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Properties"
                           asp-action="Create"
                           class="btn btn-outline-light btn-lg px-4 py-3 rounded-3 fw-semibold">

                            + List Property

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-outline-light btn-lg px-4 py-3 rounded-3 fw-semibold">

                            Get Started

                        </a>
                    }

                </div>

            </div>


            <!-- Hero Property Card -->
            <div class="col-lg-5">

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                    <div style="
                        height: 260px;
                        background: linear-gradient(
                            135deg,
                            #dbeafe,
                            #bfdbfe
                        );
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:100px;">

                        🏡

                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    FEATURED PROPERTY
                                </small>

                                <h4 class="fw-bold mb-1">
                                    Your Dream Home
                                </h4>

                                <p class="text-muted mb-0">
                                    📍 Find it in your favorite location
                                </p>

                            </div>

                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                New
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     SEARCH BOX
========================= -->

<section class="container"
         style="margin-top:-85px;">

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-body p-4">

            <div class="row g-3 align-items-end">

                <div class="col-lg-4">

                    <label class="form-label fw-semibold">
                        📍 Location
                    </label>

                    <input type="text"
                           class="form-control form-control-lg rounded-3"
                           placeholder="Where do you want to live?" />

                </div>

                <div class="col-lg-3">

                    <label class="form-label fw-semibold">
                        🏠 Property Type
                    </label>

                    <select class="form-select form-select-lg rounded-3">

                        <option selected>
                            All Properties
                        </option>

                        <option>Apartment</option>
                        <option>House</option>
                        <option>Villa</option>
                        <option>Land</option>
                        <option>Office</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label fw-semibold">
                        💰 Price Range
                    </label>

                    <select class="form-select form-select-lg rounded-3">

                        <option selected>
                            Any Price
                        </option>

                        <option>Under 50 Lac</option>
                        <option>50 Lac - 1 Crore</option>
                        <option>1 - 2 Crore</option>
                        <option>Above 2 Crore</option>

                    </select>

                </div>

                <div class="col-lg-2">

                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold">

                        Search 🔍

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     STATS
========================= -->

<section class="container py-5">

    <div class="row g-4 text-center">

        <div class="col-md-4">

            <div class="p-4">

                <h2 class="display-5 fw-bold text-primary">
                    100+
                </h2>

                <p class="text-muted mb-0">
                    Property Listings
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="p-4">

                <h2 class="display-5 fw-bold text-primary">
                    50+
                </h2>

                <p class="text-muted mb-0">
                    Verified Agents
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="p-4">

                <h2 class="display-5 fw-bold text-primary">
                    500+
                </h2>

                <p class="text-muted mb-0">
                    Happy Users
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     WHY CHOOSE US
========================= -->

<section class="container py-5">

    <div class="text-center mb-5">

        <span class="text-primary fw-bold small">
            WHY CHOOSE US
        </span>

        <h2 class="display-6 fw-bold mt-2">
            Everything You Need
        </h2>

        <p class="text-muted">
            A smarter and simpler way to find your next property.
        </p>

    </div>


    <div class="row g-4">

        <!-- Card 1 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="rounded-4 bg-primary bg-opacity-10
                                d-inline-flex align-items-center
                                justify-content-center mb-4"
                         style="width:65px;height:65px;font-size:30px;">

                        🔍

                    </div>

                    <h4 class="fw-bold">
                        Smart Search
                    </h4>

                    <p class="text-muted">
                        Quickly find properties using location,
                        property type, price, bedrooms and other filters.
                    </p>

                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="text-primary text-decoration-none fw-semibold">

                        Explore →
                    </a>

                </div>

            </div>

        </div>


        <!-- Card 2 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="rounded-4 bg-danger bg-opacity-10
                                d-inline-flex align-items-center
                                justify-content-center mb-4"
                         style="width:65px;height:65px;font-size:30px;">

                        ❤️

                    </div>

                    <h4 class="fw-bold">
                        Save Favorites
                    </h4>

                    <p class="text-muted">
                        Save properties you love and easily
                        come back to them whenever you want.
                    </p>

                    <span class="text-primary fw-semibold">
                        Coming Soon →
                    </span>

                </div>

            </div>

        </div>


        <!-- Card 3 -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="rounded-4 bg-success bg-opacity-10
                                d-inline-flex align-items-center
                                justify-content-center mb-4"
                         style="width:65px;height:65px;font-size:30px;">

                        🤝

                    </div>

                    <h4 class="fw-bold">
                        Connect with Agents
                    </h4>

                    <p class="text-muted">
                        Connect with property agents and
                        make your property buying journey easier.
                    </p>

                    <span class="text-primary fw-semibold">
                        Coming Soon →
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CALL TO ACTION
========================= -->

<section class="container py-5 mb-5">

    <div class="rounded-4 p-5 text-center text-white shadow-lg"
         style="background: linear-gradient(135deg, #1e293b, #0f172a);">

        <div class="mb-3"
             style="font-size:55px;">
            🏠
        </div>

        <h2 class="display-6 fw-bold mb-3">
            Ready to Find Your Dream Property?
        </h2>

        <p class="text-white-50 mx-auto mb-4"
           style="max-width:600px;">

            Start exploring our marketplace today and
            discover a property that feels like home.

        </p>

        <a asp-controller="Properties"
           asp-action="Index"
           class="btn btn-light btn-lg px-5 py-3 rounded-3 fw-semibold">

            Browse Properties →

        </a>

    </div>

</section>


